# ---- Public (safe for the browser) ----
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---- Server only (NEVER exposed to the client) ----
SUPABASE_SECRET_KEY=
# Fine-grained PAT, scoped to ONLY the demo repo, Contents:RW + Pull requests:RW + Actions/Checks:Read.
# (Replaces the GitHub App for NightHack — simpler, backend-only, identical demo.)
GITHUB_TOKEN=
GITHUB_DEMO_OWNER=
GITHUB_DEMO_REPO=atlas-store-demo
GITHUB_DEMO_BASE_BRANCH=demo-base

# Optional: only used for human-readable explanation, never on the critical path.
MODEL_API_KEY=

DEMO_MODE=true

# ---- GitHub App production foundation (server-only) ----
# These settings prepare production GitHub App authentication. They do not switch
# the existing PAT-backed demo behavior.
# GitHub App numeric ID.
GITHUB_APP_ID=
# Public GitHub App slug used only to construct the official installation URL.
GITHUB_APP_SLUG=
# GitHub App OAuth client ID and secret. Both are read only by server routes.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# PEM private key for the GitHub App; keep server-only and preserve newlines.
GITHUB_APP_PRIVATE_KEY=
# Keep "Request user authorization (OAuth) during installation" disabled.
# /api/github/setup is the Setup URL.
# /api/github/callback is the OAuth Callback URL.
# Bridge starts a PKCE-protected phase after installation.
# Webhook secret configured in the GitHub App settings.
GITHUB_APP_WEBHOOK_SECRET=
# Base64-encoded 32-byte key used to encrypt GitHub installation references.
GITHUB_INSTALLATION_REFERENCE_KEY=
